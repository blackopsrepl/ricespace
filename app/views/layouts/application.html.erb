<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "RiceSpace" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="RiceSpace">

    <%# What a link to this page looks like when it is pasted somewhere. Without it a shared
        page is a bare URL, and a page is a thing people share — the whole product is somebody
        showing their desktop to somebody else. Each page sets its own description; the site's
        own is the fallback. The image is the mascot, since a page's look is the owner's and
        cannot be known before it is fetched. %>
    <% description = content_for(:description) || "A page per account, and the HTML and CSS to fill it. Your desktop, on a page you wrote yourself." %>
    <% page_title = content_for(:title) || "RiceSpace" %>
    <meta name="description" content="<%= description %>">
    <meta property="og:type" content="<%= content_for(:og_type) || "website" %>">
    <meta property="og:site_name" content="RiceSpace">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="<%= "#{request.base_url}/icon.png" %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= "#{request.base_url}/icon.png" %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# `javascript_importmap_tags` picks up the nonce from the generator on its own;
      this one is written out by hand, so it needs it named or it does not run. %>
  <script type="module" nonce="<%= content_security_policy_nonce %>">
    // The profile song. Autoplay, as the era's pages did it — but browsers refuse
    // audible autoplay until the visitor has interacted with the page, so this starts
    // the track on the first interaction and does nothing if the browser says no.
    // There is never a prompt and never a second attempt per interaction.
    const song = document.querySelector("audio.song");
    if (song) {
      const start = () => {
        song.play().then(() => {
          document.removeEventListener("pointerdown", start);
          document.removeEventListener("keydown", start);
        }).catch(() => {});
      };
      document.addEventListener("pointerdown", start, { once: true });
      document.addEventListener("keydown", start, { once: true });
    }
  </script>

  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <%# The site's chrome: one hairline, a wordmark, and uppercase labels for
        destinations. No logo, no icons, no shadow — the loudest thing on any page here
        is supposed to be somebody's desktop, so the chrome stays quiet. %>
    <header id="site-header" class="border-b border-zinc-800">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
        <%= link_to root_path, class: "flex items-baseline gap-3" do %>
          <span class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-100">RiceSpace</span>
          <span class="label hidden sm:inline">pages you build</span>
        <% end %>

        <nav class="flex items-center gap-5">
          <%= link_to "Showcase", root_path, class: "label hover:text-zinc-200" %>
          <%= link_to "Layouts", layouts_path, class: "label hover:text-zinc-200" %>
          <%= link_to "Agents", agents_path, class: "label hover:text-zinc-200" %>
          <% if signed_in? %>
            <%= link_to "Studio", studio_path, class: "label hover:text-zinc-200" %>
            <%= link_to "Your page", profile_path(current_user), class: "label hover:text-zinc-200" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "label hover:text-zinc-200" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "label hover:text-zinc-200" %>
            <%= link_to "Create a page", new_registration_path, class: "btn btn-primary" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash.any? %>
      <div class="mx-auto max-w-6xl space-y-px px-6 pt-4">
        <% flash.each do |kind, message| %>
          <% next if message.blank? %>
          <p class="border px-3 py-2 text-sm <%= kind.to_s == "alert" ? "border-red-900 bg-red-950 text-red-200" : "border-emerald-900 bg-emerald-950 text-emerald-200" %>">
            <%= message %>
          </p>
        <% end %>
      </div>
    <% end %>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <%= yield %>
    </main>

    <footer class="mt-16 border-t border-zinc-800">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-6">
        <p class="label">Markup by its owner, cleaned on render</p>
        <%= link_to "Read the agent contract", agents_path, class: "label hover:text-zinc-200" %>
      </div>
    </footer>
  </body>
</html>
