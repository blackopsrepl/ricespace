<% content_for :title, "#{@layout.name} — RiceSpace" %>

<header class="mb-8 flex flex-wrap items-end justify-between gap-6">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight"><%= @layout.name %></h1>
    <p class="label mt-3">by <%= @layout.author %> — <%= @layout.description %></p>
  </div>
  <p class="flex flex-wrap items-center gap-2">
    <%= link_to "All layouts", layouts_path, class: "btn" %>
    <% if signed_in? %>
      <%= button_to "Wear this layout", apply_layout_path(@layout), method: :post, class: "btn btn-primary",
            form: { data: { turbo_confirm: "Wear “#{@layout.name}”? It layers under your own rules — what you changed stays yours." } } %>
      <span class="label">keeps your rules</span>
    <% end %>
  </p>
</header>

<p class="label mb-6">
  <% if @profile %>
    previewing against your page
  <% else %>
    previewing against an empty page —
    <%= link_to "sign in", new_session_path, class: "hover:text-zinc-200" %> to see it against your own parts
  <% end %>
</p>

<%# The layout rendered exactly as it renders on a page: written into the document after
    everything the site loads, over the same anatomy. The card it sits in is deliberately
    plain and uncoloured — a white card under a dark theme was previewing the card, not
    the theme. %>
<%= author_stylesheet(@layout.css) %>

<article class="layout-preview border border-zinc-800 bg-zinc-950 p-6 text-zinc-100">
  <div class="contactTable flex items-start gap-4">
    <div class="profile-pic">
      <div class="profile-pic-default flex h-24 w-24 items-center justify-center border border-dashed border-zinc-400">
        <span class="label">pic</span>
      </div>
    </div>
    <div class="contactInfo">
      <h1 class="nametext text-2xl font-bold">
        <%= @profile&.user&.display_name.presence || "Your Name" %>
      </h1>
      <p class="username label mt-1">@<%= @profile&.user&.username || "username" %></p>
      <p class="greeting mt-2"><%= @profile&.user&.greeting.presence || "welcome to my page" %></p>
      <p class="mood mt-1"><%= @profile&.user&.mood.presence || "mood" %></p>
    </div>
  </div>

  <div id="profile" class="profile-page mt-6">
    <% if @profile&.document.present? %>
      <%= @profile.rendered.html %>
    <% else %>
      <center><h1>Your page</h1></center>
      <marquee>your markup goes here</marquee>
      <p>Paste a layout, then write over it.</p>
    <% end %>
  </div>

  <section id="blurbs" class="mt-8">
    <article class="blurb">
      <h2 class="blurb-title orangetext15">Interests</h2>
      <p>modems, the sound of a 56k handshake, guestbooks</p>
    </article>
  </section>

  <section class="friendSpace mt-8">
    <h2 class="orangetext15">friends</h2>
    <ul class="top8 flex gap-4">
      <li class="friend">friend</li>
      <li class="friend">friend</li>
      <li class="friend">friend</li>
    </ul>
  </section>

  <section id="comments" class="comments mt-8">
    <h2 class="orangetext15">comments</h2>
    <div class="comment">
      <span class="nametext">a visitor</span>
      <p class="comment-body">nice page</p>
    </div>
  </section>
</article>

<details class="mt-8">
  <summary class="label cursor-pointer hover:text-zinc-200">The stylesheet</summary>
  <pre class="mt-3 overflow-x-auto border border-zinc-800 bg-zinc-950 p-3 text-xs text-zinc-300"><%= @layout.css %></pre>
</details>
