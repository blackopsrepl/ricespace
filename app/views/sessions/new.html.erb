<% content_for :title, "Sign in — RiceSpace" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-bold tracking-tight">Sign in</h1>

  <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm text-zinc-400" %>
      <%= form.email_field :email_address, value: @email_address, required: true, autocomplete: "username",
            class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
    </div>
    <div>
      <%= form.label :password, "Password", class: "block text-sm text-zinc-400" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
    </div>
    <%= form.submit "Sign in",
          class: "w-full rounded bg-fuchsia-500 px-4 py-2 font-medium text-zinc-950 hover:bg-fuchsia-400" %>
  <% end %>

  <p class="mt-6 text-sm text-zinc-500">
    No page yet? <%= link_to "Create one", new_registration_path, class: "text-fuchsia-400 hover:text-fuchsia-300" %>.
  </p>
</div>
