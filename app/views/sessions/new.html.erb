<% content_for :title, "Sign in — RiceSpace" %>

<div class="mx-auto max-w-md">
  <h1 class="text-3xl font-semibold tracking-tight">Sign in</h1>

  <%= form_with url: session_path, class: "mt-8 grid gap-5" do |form| %>
    <label class="block">
      <span class="label">email address</span>
      <%= form.email_field :email_address, value: @email_address, required: true, autocomplete: "username",
            class: "field mt-2" %>
    </label>
    <label class="block">
      <span class="label">password</span>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            class: "field mt-2" %>
    </label>
    <%= form.submit "Sign in", class: "btn btn-primary w-full justify-center" %>
  <% end %>

  <p class="mt-8 text-sm text-zinc-500">
    No page yet? <%= link_to "Create one", new_registration_path, class: "underline hover:text-zinc-200" %>.
  </p>
</div>
