<% content_for :title, "Create a page — RiceSpace" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-bold tracking-tight">Create a page</h1>
  <p class="mt-2 text-sm text-zinc-400">
    Your username is your page address. Your page starts empty and is yours to write.
  </p>

  <% if @user.errors.any? %>
    <ul class="mt-4 space-y-1 rounded border border-red-800 bg-red-950/60 p-3 text-sm text-red-200">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :username, "Username", class: "block text-sm text-zinc-400" %>
      <%= form.text_field :username, required: true, autocomplete: "username",
            class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
      <p class="mt-1 text-xs text-zinc-600">Lowercase letters, digits and hyphens. Becomes /profiles/&lt;username&gt;.</p>
    </div>
    <div>
      <%= form.label :name, "Display name", class: "block text-sm text-zinc-400" %>
      <%= form.text_field :name, autocomplete: "name",
            class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
    </div>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm text-zinc-400" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email",
            class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
    </div>
    <div>
      <%= form.label :password, "Password", class: "block text-sm text-zinc-400" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password",
            class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
      <p class="mt-1 text-xs text-zinc-600">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
    </div>
    <%= form.submit "Create my page",
          class: "w-full rounded bg-fuchsia-500 px-4 py-2 font-medium text-zinc-950 hover:bg-fuchsia-400" %>
  <% end %>
</div>
