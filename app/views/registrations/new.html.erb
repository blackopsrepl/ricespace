<% content_for :title, "Create a page — RiceSpace" %>

<div class="mx-auto max-w-md">
  <h1 class="text-3xl font-semibold tracking-tight">Create a page</h1>
  <p class="mt-3 text-zinc-400">
    Your username is your page address. Your page starts empty and is yours to write.
  </p>

  <% if @user.errors.any? %>
    <ul class="mt-6 space-y-px border border-red-900 bg-red-950 p-3 text-sm text-red-200">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-8 grid gap-5" do |form| %>
    <label class="block">
      <span class="label">username</span>
      <%= form.text_field :username, required: true, autocomplete: "username", class: "field mt-2" %>
      <span class="label mt-2 block">lowercase letters, digits and hyphens — becomes /profiles/&lt;username&gt;</span>
    </label>
    <label class="block">
      <span class="label">display name</span>
      <%= form.text_field :name, autocomplete: "name", class: "field mt-2" %>
    </label>
    <label class="block">
      <span class="label">email address</span>
      <%= form.email_field :email_address, required: true, autocomplete: "email", class: "field mt-2" %>
    </label>
    <label class="block">
      <span class="label">password</span>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "field mt-2" %>
      <span class="label mt-2 block">at least <%= User::MINIMUM_PASSWORD_LENGTH %> characters</span>
    </label>
    <%= form.submit "Create my page", class: "btn btn-primary w-full justify-center" %>
  <% end %>
</div>
