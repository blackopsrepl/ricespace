<% content_for :title, "#{@user.display_name} — RiceSpace" %>

<%# The author's stylesheet, written after everything the site itself loads, so a
    profile can restyle the whole page — the site's chrome included. This is the
    part of the old profiles that was never a rich-text field, and it is why this
    tag is here rather than scoped to the markup below. It is cleaned by PageCss,
    and emitted raw — see ApplicationHelper#author_stylesheet for why that is both
    necessary and safe. %>
<%= author_stylesheet(@rendered.css) %>

<%#
  THE PAGE. Two halves, in this order and no other:

    #showcase   the rice — the reason the page exists
    #profile    what its owner wrote — a bare document, no column, no card

  The names below are a contract with every stylesheet anybody has pasted in, from
  before there was such a contract:

    .contactTable   the name, greeting, mood and picture block
    .profile-pic    the picture beside the name
    .nametext       a display name (the page's, a friend's, a commenter's)
    .orangetext15   a section heading
    #profile        the markup the owner wrote, and only that
    #showcase       the rice — .rice-frame, .rice-shot, .fact, .fact-value
    .blurb          one titled block of the owner's text, with .blurb-title
    .friendSpace    the friends list — .top8, .friend, .friendCount
    .comments       comments and their form — .comment, .comment-body, .commentCount
    .audio.player   the profile song, with audio.song

  Renaming one is a breaking change for every layout an owner has already pasted in.
%>

<header id="profile-header" class="mb-10 flex flex-wrap items-start justify-between gap-6">
  <div class="contactTable flex items-start gap-5">
    <div class="profile-pic">
      <% if @picture&.image&.attached? %>
        <%= image_tag @picture.image.variant(:display), alt: @user.display_name,
              class: "h-28 w-28 border border-zinc-700 object-cover" %>
      <% else %>
        <div class="profile-pic-default flex h-28 w-28 items-center justify-center border border-dashed border-zinc-800">
          <span class="label">no pic</span>
        </div>
      <% end %>
    </div>

    <div class="contactInfo">
      <h1 class="nametext text-3xl font-semibold tracking-tight"><%= @user.display_name %></h1>
      <p class="username label mt-2">@<%= @user.username %></p>

      <% if @user.greeting.present? %>
        <p class="greeting mt-4 max-w-xl text-zinc-300"><%= @user.greeting %></p>
      <% end %>

      <% if @user.mood.present? || @user.headline.present? %>
        <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
          <% if @user.mood.present? %>
            <div class="fact">
              <dt class="label">mood</dt>
              <dd class="fact-value"><%= @user.mood %></dd>
            </div>
          <% end %>
          <% if @user.headline.present? %>
            <div class="fact">
              <dt class="label">headline</dt>
              <dd class="fact-value"><%= @user.headline %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <% if @can_edit %>
          <%= link_to "Edit page", studio_path, class: "btn" %>
          <%= link_to "Edit showcase", edit_showcase_path, class: "btn" %>
        <% end %>

        <%# How a layout spread the first time: you found a page you liked and took its
            stylesheet. Signed out, the offer is to sign in and take it. %>
        <% if @rendered.css.present? %>
          <% if signed_in? && current_user != @user %>
            <%= button_to "Take this layout", copy_layout_profile_path(@user), method: :post, class: "btn" %>
          <% elsif !signed_in? %>
            <%= link_to "Sign in to take this layout", new_session_path, class: "btn" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# The profile song, set as a fact rather than a widget: it is one line of
      information and one control. Native audio because it is one track and the page
      plays it, with `preload: "none"` so opening a page does not download somebody's
      song before they ask for it. %>
  <% if @profile.song? %>
    <div class="audio player w-full border border-zinc-800 p-3 sm:w-auto sm:max-w-sm">
      <p class="label">profile song</p>
      <p class="song-title mt-1 truncate text-sm text-zinc-200">
        <%= @profile.song_title.presence || File.basename(URI.parse(@profile.song_url).path) %>
      </p>
      <audio class="song mt-3 w-full" controls preload="none" src="<%= @profile.song_url %>"></audio>
    </div>
  <% end %>
</header>

<%# ── THE SHOWCASE ────────────────────────────────────────────────────────────────
    The rice, and the main event. It is the loudest thing on the page — a hard offset
    frame around the screenshot, the facts of the setup ruled underneath, the
    description in the owner's own markup — because a page is what somebody wrote but
    a rice is what they built, and this site exists for the second one. Everything a
    visitor needs to read it is here and nothing is behind a click. %>
<section id="showcase" class="showcase mb-14">
  <% if @showcase&.filled? %>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-4">
        <span class="rice-label">the rice</span>
        <% if @showcase.title.present? %>
          <h2 class="rice-title text-xl font-semibold tracking-tight"><%= @showcase.title %></h2>
        <% end %>
      </div>
      <% if @showcase.shots.size > 1 %>
        <p class="label"><%= pluralize(@showcase.shots.size, "shot") %></p>
      <% end %>
    </div>

    <% if @showcase.cover %>
      <figure class="rice-frame">
        <%= image_tag @showcase.cover.image.variant(:display),
              alt: @showcase.cover.caption.presence || "#{@user.display_name}'s desktop",
              class: "rice-shot block w-full" %>
        <% if @showcase.cover.caption.present? %>
          <figcaption class="border-t border-zinc-800 px-4 py-3">
            <span class="label"><%= @showcase.cover.caption %></span>
          </figcaption>
        <% end %>
      </figure>
    <% end %>

    <%# The other shots, as a strip of stills rather than a gallery: no lightbox, no
        carousel, no script. The page is a page. %>
    <% others = @showcase.shots.drop(1).select { |shot| shot.image.attached? } %>
    <% if others.any? %>
      <ul class="mt-4 grid grid-cols-2 gap-px border border-zinc-800 sm:grid-cols-3 lg:grid-cols-4">
        <% others.each do |shot| %>
          <li class="rice-meta bg-zinc-950">
            <%= image_tag shot.image.variant(:thumb), alt: shot.caption.presence || "",
                  class: "block aspect-[8/5] w-full object-cover" %>
            <% if shot.caption.present? %>
              <p class="label border-t border-zinc-800 px-2 py-1.5"><%= shot.caption %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @showcase.summary.present? %>
      <p class="rice-summary mt-6 max-w-3xl text-lg leading-relaxed text-zinc-300"><%= @showcase.summary %></p>
    <% end %>

    <% if @showcase.facts.any? %>
      <dl class="mt-7 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        <% @showcase.facts.each do |label, value| %>
          <div class="fact">
            <dt class="label"><%= label %></dt>
            <dd class="fact-value" title="<%= value %>"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <% if @showcase.details.present? %>
      <div id="showcase-details" class="showcase-details mt-7 max-w-3xl border-t border-zinc-800 pt-5 text-zinc-300">
        <%= @showcase.rendered_details %>
      </div>
    <% end %>
  <% elsif @can_edit %>
    <div class="border border-dashed border-zinc-800 p-8">
      <span class="rice-label">the rice</span>
      <p class="mt-5 max-w-xl text-zinc-400">
        Your showcase is empty, and it is the main event on this page. Put a screenshot
        of your desktop here, say what is in it, and list what you run — it is the part
        people come to look at.
      </p>
      <%= link_to "Build your showcase", edit_showcase_path, class: "btn btn-primary mt-5" %>
    </div>
  <% end %>
</section>

<%# ── THE PAGE ITSELF ─────────────────────────────────────────────────────────────
    What the owner wrote, in the author's own stylesheet. No column around it and no
    card of ours: the page's own rules decide what it looks like, including whether the
    site's chrome is still here. %>
<article id="profile" class="profile-page mb-12">
  <% if @profile.document.blank? %>
    <div class="border border-dashed border-zinc-800 p-8">
      <p class="label">your page</p>
      <p class="mt-4 text-zinc-400">
        No markup yet — this is where anything you want goes, in HTML and CSS.
        <% if @can_edit %>
          <%= link_to "Write it", studio_path, class: "underline hover:text-zinc-200" %>.
        <% end %>
      </p>
    </div>
  <% else %>
    <%= @rendered.html %>
  <% end %>
</article>

<% if @blurbs.any? %>
  <section id="blurbs" class="mb-12">
    <% @blurbs.each do |blurb| %>
      <article class="blurb mb-6 max-w-3xl" id="blurb-<%= blurb.id %>">
        <h2 class="blurb-title orangetext15 rule label"><%= blurb.title %></h2>
        <div class="blurb-body mt-3 text-zinc-300"><%= blurb.rendered_body %></div>
      </article>
    <% end %>
  </section>
<% end %>

<section id="friends" class="friendSpace mb-12">
  <h2 class="orangetext15 rule">
    <span class="label">friends</span>
    <span class="label friendCount text-zinc-400"><%= @friend_count %></span>
  </h2>

  <% if @friends.any? %>
    <ul class="top8 mt-5 grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-6">
      <% @friends.each_with_index do |friend, index| %>
        <li class="friend<%= " top8-slot" if index < ProfilesController::TOP_EIGHT %>">
          <%= link_to profile_path(friend), class: "group block border-t-2 pt-2 #{index < ProfilesController::TOP_EIGHT ? "border-amber-400" : "border-zinc-800"} hover:border-zinc-500" do %>
            <% if friend.profile_picture&.image&.attached? %>
              <%= image_tag friend.profile_picture.image.variant(:thumb), alt: friend.display_name,
                    class: "block aspect-square w-full border border-zinc-800 object-cover" %>
            <% else %>
              <span class="flex aspect-square w-full items-center justify-center border border-dashed border-zinc-800">
                <span class="label"><%= friend.username.truncate(8) %></span>
              </span>
            <% end %>
            <span class="nametext mt-2 block truncate text-sm text-zinc-300 group-hover:text-zinc-100">
              <%= friend.display_name.truncate(16) %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @friend_count > @friends.size %>
      <p class="label mt-4">and <%= @friend_count - @friends.size %> more</p>
    <% end %>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">No friends listed yet.</p>
  <% end %>

  <% if @can_edit %>
    <%= form_with url: friendships_path, class: "mt-5 flex flex-wrap items-center gap-2" do |form| %>
      <%= form.text_field :username, placeholder: "their username", required: true, class: "field w-48" %>
      <%= form.submit "Add friend", class: "btn" %>
    <% end %>
  <% end %>
</section>

<section id="comments" class="comments mb-12">
  <h2 class="orangetext15 rule">
    <span class="label">comments</span>
    <span class="label commentCount text-zinc-400"><%= @user.comments.count %></span>
  </h2>

  <%= form_with model: @comment, url: profile_comments_path(@user.username), id: "comment-form", class: "mt-5 max-w-2xl" do |form| %>
    <% unless signed_in? %>
      <%= form.text_field :author_name, placeholder: "your name", maxlength: Comment::MAX_AUTHOR_NAME_LENGTH,
            class: "field mb-2 w-56" %>
    <% end %>
    <div class="flex flex-wrap items-start gap-2">
      <%= form.text_area :body, rows: 3, required: true, placeholder: "leave a comment", class: "field" %>
      <%= form.submit "Comment", class: "btn" %>
    </div>
  <% end %>

  <% if @comments.any? %>
    <ul class="mt-6 space-y-px border border-zinc-800">
      <% @comments.each do |comment| %>
        <li class="comment bg-zinc-950 p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="nametext text-sm text-zinc-200"><%= comment.displayed_author %></span>
            <span class="label"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <p class="comment-body mt-2 whitespace-pre-wrap text-sm text-zinc-300"><%= comment.body %></p>
          <% if signed_in? && (current_user == @user || current_user == comment.author) %>
            <p class="mt-2 text-right">
              <%= button_to "Remove", comment_path(comment), method: :delete, class: "label hover:text-red-300" %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">No comments yet.</p>
  <% end %>
</section>

<p id="profile-stamp" class="label">
  markup by @<%= @user.username %>, last changed <%= time_ago_in_words(@profile.updated_at) %> ago
</p>
