<% content_for :title, "#{@user.display_name} — RiceSpace" %>

<%# The author's stylesheet, written after everything the site itself loads, so a
    profile can restyle the whole page — the site's chrome included. This is the
    part of the old profiles that was never a rich-text field, and it is why this
    tag is here rather than scoped to the markup below. It is cleaned by PageCss,
    and emitted raw — see ApplicationHelper#author_stylesheet for why that is both
    necessary and safe. %>
<%= author_stylesheet(@rendered.css) %>

<%#
  The page's anatomy. Everything below this comment is what a layout from the era
  targets by name, and the names are deliberate:

    .profile-pic    the picture beside the name
    .contactTable   the name, greeting, mood and picture block
    #profile        the page's own markup, where the owner writes
    .blurb          one titled block of the owner's text
    .friendSpace    the friends list and its count
    .comments       what visitors left

  A stylesheet pasted from 2006 lands on these. Renaming one is a breaking change
  for every layout an owner has already pasted in.
%>

<header id="profile-header" class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="contactTable flex items-start gap-4">
    <div class="profile-pic">
      <% if @picture&.image&.attached? %>
        <%= image_tag @picture.image.variant(:display), alt: @user.display_name,
              class: "h-24 w-24 rounded border border-zinc-700 object-cover" %>
      <% else %>
        <div class="profile-pic-default flex h-24 w-24 items-center justify-center rounded border border-dashed border-zinc-700 text-xs text-zinc-600">
          no pic
        </div>
      <% end %>
    </div>

    <div class="contactInfo">
      <h1 class="nametext text-2xl font-bold tracking-tight"><%= @user.display_name %></h1>
      <p class="username text-sm text-zinc-500">@<%= @user.username %></p>
      <% if @user.greeting.present? %>
        <p class="greeting mt-1 text-zinc-300"><%= @user.greeting %></p>
      <% end %>
      <% if @user.mood.present? %>
        <p class="mood mt-1 text-sm text-zinc-400"><%= @user.mood %></p>
      <% end %>
      <% if @user.headline.present? %>
        <p class="headline mt-1 max-w-xl text-sm text-zinc-400"><%= @user.headline %></p>
      <% end %>

      <% if @can_edit %>
        <p class="mt-2 flex flex-wrap gap-3 text-xs">
          <%= link_to "Edit this page", studio_path, class: "text-fuchsia-400 hover:text-fuchsia-300" %>
          <%= link_to "Write it with an agent", agents_path, class: "text-fuchsia-400 hover:text-fuchsia-300" %>
        </p>
      <% end %>

      <%# How a layout spread the first time: you found a page you liked and took its
          stylesheet. Signed out, the offer is to sign in and take it. %>
      <% if @rendered.css.present? %>
        <p class="mt-2 text-xs">
          <% if signed_in? && current_user != @user %>
            <%= button_to "Take this layout", copy_layout_profile_path(@user), method: :post,
                  class: "rounded border border-zinc-700 px-2 py-1 text-zinc-300 hover:border-zinc-500 hover:text-zinc-100" %>
          <% elsif !signed_in? %>
            <%= link_to "Sign in to take this layout", new_session_path, class: "text-zinc-500 hover:text-zinc-300" %>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>
</header>

<%# The profile song. Native audio because it is one track and the page plays it:
    no library, no custom player, and `preload: "none"` so opening a page does not
    download somebody's song before they ask for it. %>
<% if @profile.song? %>
  <div class="audio player mb-6">
    <p class="song-title text-xs text-zinc-500">
      <span class="orangetext15">profile song</span>:
      <span class="nametext"><%= @profile.song_title.presence || File.basename(URI.parse(@profile.song_url).path) %></span>
    </p>
    <audio class="song" controls preload="none" src="<%= @profile.song_url %>"></audio>
  </div>
<% end %>

<%# The page the owner wrote. Inside an element whose id a stylesheet may reach,
    and nothing else: no column around it, no card of ours — the page's own rules
    decide what it looks like, including whether the site's chrome is still here. %>
<article id="profile" class="profile-page">
  <% if @profile.document.blank? %>
    <p class="rounded-lg border border-dashed border-zinc-800 p-6 text-sm text-zinc-500">
      This page has no markup yet.
      <% if @can_edit %>
        <%= link_to "Write it", studio_path, class: "text-fuchsia-400 hover:text-fuchsia-300" %>.
      <% else %>
        It is still blank.
      <% end %>
    </p>
  <% else %>
    <%= @rendered.html %>
  <% end %>
</article>

<% if @blurbs.any? %>
  <section id="blurbs" class="mt-8 space-y-4">
    <% @blurbs.each do |blurb| %>
      <article class="blurb" id="blurb-<%= blurb.id %>">
        <h2 class="blurb-title orangetext15 text-sm font-semibold uppercase tracking-wider text-zinc-400"><%= blurb.title %></h2>
        <div class="blurb-body mt-1 text-zinc-300"><%= blurb.rendered_body %></div>
      </article>
    <% end %>
  </section>
<% end %>

<section id="friends" class="friendSpace mt-10 border-t border-zinc-800 pt-6">
  <h2 class="orangetext15 text-sm font-semibold uppercase tracking-wider text-zinc-500">
    <%= @user.display_name %>’s friends (<span class="friendCount"><%= @friend_count %></span>)
  </h2>

  <% if @friends.any? %>
    <ul class="top8 mt-4 flex flex-wrap gap-4">
      <% @friends.each_with_index do |friend, index| %>
        <li class="friend<%= " top8-slot" if index < ProfilesController::TOP_EIGHT %>">
          <%= link_to profile_path(friend), class: "flex w-20 flex-col items-center gap-1 text-center" do %>
            <% if friend.profile_picture&.image&.attached? %>
              <%= image_tag friend.profile_picture.image.variant(:thumb), alt: friend.display_name,
                    class: "h-16 w-16 rounded border border-zinc-700 object-cover" %>
            <% else %>
              <span class="flex h-16 w-16 items-center justify-center rounded border border-dashed border-zinc-700 text-[10px] text-zinc-600">
                <%= friend.username.truncate(10) %>
              </span>
            <% end %>
            <span class="nametext text-xs text-zinc-400"><%= friend.display_name.truncate(14) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @friend_count > @friends.size %>
      <p class="mt-3 text-xs text-zinc-600">and <%= @friend_count - @friends.size %> more.</p>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-zinc-500">No friends listed yet.</p>
  <% end %>

  <% if @can_edit %>
    <%= form_with url: friendships_path, class: "mt-4 flex flex-wrap items-center gap-2" do |form| %>
      <%= form.text_field :username, placeholder: "their username", required: true,
            class: "rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
      <%= form.submit "Add friend",
            class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
    <% end %>
  <% end %>
</section>

<section id="comments" class="comments mt-10 border-t border-zinc-800 pt-6">
  <h2 class="orangetext15 text-sm font-semibold uppercase tracking-wider text-zinc-500">
    Comments (<span class="commentCount"><%= @user.comments.count %></span>)
  </h2>

  <%= form_with model: @comment, url: profile_comments_path(@user.username), id: "comment-form", class: "mt-4" do |form| %>
    <% unless signed_in? %>
      <%= form.text_field :author_name, placeholder: "your name", maxlength: Comment::MAX_AUTHOR_NAME_LENGTH,
            class: "mb-2 w-48 rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
    <% end %>
    <div class="flex flex-wrap items-start gap-2">
      <%= form.text_area :body, rows: 3, required: true, placeholder: "leave a comment",
            class: "w-full max-w-xl rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
      <%= form.submit "Comment",
            class: "rounded bg-fuchsia-500 px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-fuchsia-400" %>
    </div>
  <% end %>

  <% if @comments.any? %>
    <ul class="mt-5 space-y-3">
      <% @comments.each do |comment| %>
        <li class="comment rounded border border-zinc-800 bg-zinc-900/40 p-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2 text-xs">
            <span class="nametext text-zinc-300"><%= comment.displayed_author %></span>
            <span class="text-zinc-600"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <p class="comment-body mt-1 whitespace-pre-wrap text-sm text-zinc-300"><%= comment.body %></p>
          <% if signed_in? && (current_user == @user || current_user == comment.author) %>
            <p class="mt-1 text-right">
              <%= button_to "Remove", comment_path(comment), method: :delete,
                    class: "text-xs text-red-400 hover:text-red-300" %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">No comments yet.</p>
  <% end %>
</section>

<p id="profile-stamp" class="mt-10 text-xs text-zinc-600">
  Markup by @<%= @user.username %>, last changed <%= time_ago_in_words(@profile.updated_at) %> ago.
</p>
