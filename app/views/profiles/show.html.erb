<% content_for :title, "#{@user.display_name} — RiceSpace" %>

<%# The author's stylesheet, written after everything the site itself loads, so a
    profile can restyle the whole page — the site's chrome included. This is the
    part of the old profiles that was never a rich-text field, and it is why this
    tag is here rather than scoped to the markup below. It is cleaned by PageCss. %>
<% if @rendered.css.present? %>
  <style><%= @rendered.css %></style>
<% end %>

<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight"><%= @user.display_name %></h1>
    <p class="text-sm text-zinc-500">@<%= @user.username %></p>
    <% if @user.headline.present? %>
      <p class="mt-2 max-w-xl text-zinc-400"><%= @user.headline %></p>
    <% end %>
  </div>
  <% if signed_in? && current_user == @user %>
    <%= link_to "Edit this page", studio_path,
          class: "rounded border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 hover:border-zinc-500 hover:text-zinc-100" %>
  <% end %>
</header>

<% if @profile.document.blank? %>
  <p class="rounded-lg border border-dashed border-zinc-800 p-6 text-sm text-zinc-500">
    This page has no markup yet.
    <% if signed_in? && current_user == @user %>
      <%= link_to "Write it", studio_path, class: "text-fuchsia-400 hover:text-fuchsia-300" %>.
    <% else %>
      It is still blank.
    <% end %>
  </p>
<% else %>
  <%# Where a page written by the author sits in the document: inside an element
      whose id a stylesheet may reach, and nothing else. No column around it and no
      card of ours — the page's own rules decide what it looks like, including
      whether the site's chrome is still visible. %>
  <article id="profile" class="profile-page">
    <%= @rendered.html %>
  </article>
  <p id="profile-stamp" class="mt-3 text-xs text-zinc-600">
    Markup by @<%= @user.username %>, last changed <%= time_ago_in_words(@profile.updated_at) %> ago.
  </p>
<% end %>
