<% content_for :title, "#{@user.display_name} — RiceSpace" %>
<% content_for :og_type, "profile" %>
<% content_for :description, [ @user.headline, @user.greeting, "A RiceSpace page by @#{@user.username}." ].compact_blank.first %>

<%= author_stylesheet(@rendered.css) %>

<%#
  THE PAGE. MySpace-inspired layout, modern execution:

  1. Contact table (hero) — picture, name, greeting, mood, member since
  2. Top 8 friends — the social centerpiece
  3. Comment wall — where people leave their mark
  4. About me — the owner's blurbs
  5. The rice showcase — the desktop
  6. The profile markup — owner's HTML
  7. Watch — stream links
  8. Demos — demoscene releases
  9. Hardware — physical builds

  The names below are a contract with every stylesheet:
  .contactTable, .profile-pic, .nametext, .orangetext15,
  #profile, #showcase, .blurb, .friendSpace, .comments, .audio.player
%>

<%# ── 1. CONTACT TABLE (HERO) ───────────────────────────────────────────────────
    The MySpace signature: picture on the left, everything about the person on the
    right. Bigger than the old site's, because this is the first thing a visitor
    reads and the thing the owner is showing off. %>
<header id="profile-header" class="mb-12">
  <div class="contactTable flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
    <div class="profile-pic shrink-0">
      <% if @picture&.image&.attached? %>
        <%= image_tag @picture.image.variant(:display), alt: @user.display_name,
              class: "h-40 w-40 border-2 border-zinc-600 object-cover" %>
      <% else %>
        <div class="profile-pic-default flex h-40 w-40 items-center justify-center border-2 border-dashed border-zinc-700">
          <span class="label">no pic</span>
        </div>
      <% end %>
    </div>
    <div class="contactInfo min-w-0 flex-1">
      <h1 class="nametext text-4xl font-bold tracking-tight"><%= @user.display_name %></h1>
      <p class="username label mt-2 text-sm">@<%= @user.username %></p>
      <% if @user.greeting.present? %>
        <p class="greeting mt-4 max-w-2xl text-lg text-zinc-200"><%= @user.greeting %></p>
      <% end %>
      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
        <% if @user.mood.present? %>
          <div class="fact">
            <dt class="label">mood</dt>
            <dd class="fact-value text-base"><%= @user.mood %></dd>
          </div>
        <% end %>
        <% if @user.headline.present? %>
          <div class="fact">
            <dt class="label">headline</dt>
            <dd class="fact-value text-base"><%= @user.headline %></dd>
          </div>
        <% end %>
        <div class="fact">
          <dt class="label">member since</dt>
          <dd class="fact-value text-base"><%= @user.created_at.strftime("%B %Y") %></dd>
        </div>
      </dl>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <% if @can_edit %>
          <%= link_to "Edit page", studio_path, class: "btn" %>
          <%= link_to "Edit showcase", edit_showcase_path, class: "btn" %>
        <% end %>
        <div class="rating flex items-center gap-2">
          <span class="rating-value fact-value text-xl text-amber-300" title="rating"><%= @score %></span>
          <% if signed_in? && !@can_edit %>
            <%= button_to (@my_rating == Rating::LIKE ? "★ liked" : "☆ like"),
                  rate_profile_path(@user, score: Rating::LIKE),
                  class: "btn #{'btn-primary' if @my_rating == Rating::LIKE}" %>
            <%= button_to (@my_rating == Rating::DISLIKE ? "▼ disliked" : "▼ dislike"),
                  rate_profile_path(@user, score: Rating::DISLIKE),
                  class: "btn" %>
          <% elsif !signed_in? %>
            <%= link_to "Sign in to rate this page", new_session_path, class: "btn" %>
          <% end %>
        </div>
        <% if @rendered.css.present? %>
          <% if signed_in? && current_user != @user %>
            <%= button_to "Take this layout", copy_layout_profile_path(@user), method: :post, class: "btn" %>
          <% elsif !signed_in? %>
            <%= link_to "Sign in to take this layout", new_session_path, class: "btn" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <% if @profile.song? %>
    <div class="audio player mt-6 border border-zinc-700 bg-zinc-900 p-4">
      <p class="label">profile song</p>
      <p class="song-title mt-1 truncate text-base text-zinc-100">
        <%= @profile.song_title.presence || File.basename(URI.parse(@profile.song_url).path) %>
      </p>
      <audio class="song mt-3 w-full" controls preload="none" src="<%= @profile.song_url %>"></audio>
    </div>
  <% end %>
</header>

<%# ── 2. TOP 8 FRIENDS ───────────────────────────────────────────────────────────
    The social centerpiece. Ranked grid, first eight get the amber border — the
    owner's order, which is what made the list worth ordering at all. %>
<section id="friends" class="friendSpace mb-12">
  <h2 class="orangetext15 rule">
    <span class="label">friends</span>
    <span class="label friendCount text-zinc-400"><%= @friend_count %></span>
  </h2>
  <% if @friends.any? %>
    <ul class="top8 mt-5 grid grid-cols-4 gap-4 sm:grid-cols-8">
      <% @friends.each_with_index do |friend, index| %>
        <li class="friend<%= " top8-slot" if index < ProfilesController::TOP_EIGHT %>">
          <%= link_to profile_path(friend), class: "group block" do %>
            <% if friend.profile_picture&.image&.attached? %>
              <%= image_tag friend.profile_picture.image.variant(:thumb), alt: friend.display_name,
                    class: "block aspect-square w-full border border-zinc-700 object-cover" %>
            <% else %>
              <span class="flex aspect-square w-full items-center justify-center border border-dashed border-zinc-700">
                <span class="label"><%= friend.username.truncate(8) %></span>
              </span>
            <% end %>
            <span class="nametext mt-2 block truncate text-sm text-zinc-300 group-hover:text-zinc-100">
              <%= friend.display_name.truncate(16) %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @friend_count > @friends.size %>
      <p class="label mt-4">and <%= @friend_count - @friends.size %> more</p>
    <% end %>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">No friends listed yet.</p>
  <% end %>
  <% if @can_edit %>
    <%= form_with url: friendships_path, class: "mt-5 flex flex-wrap items-center gap-2" do |form| %>
      <%= form.text_field :username, placeholder: "their username", required: true, class: "field w-48" %>
      <%= form.submit "Add friend", class: "btn" %>
    <% end %>
  <% end %>
</section>

<%# ── 3. COMMENT WALL ────────────────────────────────────────────────────────────
    The other half of the social centerpiece. A page's wall: you write on your own
    page and on anybody else's. Everything below is a comment somebody left with
    their name on it. %>
<section id="comments" class="comments mb-12">
  <h2 class="orangetext15 rule">
    <span class="label">comments</span>
    <span class="label commentCount text-zinc-400"><%= @user.comments.count %></span>
  </h2>
  <p class="label mt-2">
    <%= @can_edit ? "your wall — write on it, or write on anyone else's" : "leave your mark on @#{@user.username}'s wall" %>
  </p>
  <% if signed_in? %>
    <%= form_with model: @comment, url: profile_comments_path(@user.username), id: "comment-form", class: "mt-5 max-w-2xl" do |form| %>
      <div class="flex flex-wrap items-start gap-2">
        <%= form.text_area :body, rows: 3, required: true, placeholder: "write on @#{@user.username}'s wall as @#{current_user.username}", class: "field" %>
        <%= form.submit "Post", class: "btn" %>
      </div>
    <% end %>
  <% else %>
    <p class="mt-5 text-sm text-zinc-500">
      <%= link_to "Sign in", new_session_path, class: "underline hover:text-zinc-200" %> to post on this wall.
    </p>
  <% end %>
  <% if @comments.any? %>
    <ul class="mt-6 space-y-px border border-zinc-800">
      <% @comments.each do |comment| %>
        <li class="comment bg-zinc-950 p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="nametext text-sm text-zinc-200"><%= comment.displayed_author %></span>
            <span class="label"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <p class="comment-body mt-2 whitespace-pre-wrap text-sm text-zinc-300"><%= comment.body %></p>
          <% if signed_in? && (current_user == @user || current_user == comment.author) %>
            <p class="mt-2 text-right">
              <%= button_to "Remove", comment_path(comment), method: :delete, class: "label hover:text-red-300" %>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">Nothing on this wall yet.</p>
  <% end %>
</section>

<%# ── 4. ABOUT ME ────────────────────────────────────────────────────────────────
    The owner's own words, in titled blocks. %>
<% if @blurbs.any? %>
  <section id="blurbs" class="mb-12">
    <% @blurbs.each do |blurb| %>
      <article class="blurb mb-6 max-w-3xl" id="blurb-<%= blurb.id %>">
        <h2 class="blurb-title orangetext15 rule label"><%= blurb.title %></h2>
        <div class="blurb-body mt-3 text-zinc-300"><%= blurb.rendered_body %></div>
      </article>
    <% end %>
  </section>
<% end %>

<%# ── 5. THE RICE SHOWCASE ──────────────────────────────────────────────────────
    The desktop. The reason the site exists. %>
<section id="showcase" class="showcase mb-14">
  <% if @showcase&.filled? %>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-4">
        <span class="rice-label">the rice</span>
        <% if @showcase.title.present? %>
          <h2 class="rice-title text-xl font-semibold tracking-tight"><%= @showcase.title %></h2>
        <% end %>
      </div>
      <% if @showcase.shots.size > 1 %>
        <p class="label"><%= pluralize(@showcase.shots.size, "shot") %></p>
      <% end %>
    </div>
    <% if @showcase.cover %>
      <figure class="rice-frame">
        <%= image_tag @showcase.cover.image.variant(:display),
              alt: @showcase.cover.caption.presence || "#{@user.display_name}'s desktop",
              class: "rice-shot block w-full" %>
        <% if @showcase.cover.caption.present? %>
          <figcaption class="border-t border-zinc-800 px-4 py-3">
            <span class="label"><%= @showcase.cover.caption %></span>
          </figcaption>
        <% end %>
      </figure>
    <% end %>
    <% others = @showcase.shots.drop(1).select { |shot| shot.image.attached? } %>
    <% if others.any? %>
      <ul class="mt-4 grid grid-cols-2 gap-px border border-zinc-800 sm:grid-cols-3 lg:grid-cols-4">
        <% others.each do |shot| %>
          <li class="rice-meta bg-zinc-950">
            <%= image_tag shot.image.variant(:thumb), alt: shot.caption.presence || "",
                  class: "block aspect-[8/5] w-full object-cover" %>
            <% if shot.caption.present? %>
              <p class="label border-t border-zinc-800 px-2 py-1.5"><%= shot.caption %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if @showcase.summary.present? %>
      <p class="rice-summary mt-6 max-w-3xl text-lg leading-relaxed text-zinc-300"><%= @showcase.summary %></p>
    <% end %>
    <% if @showcase.facts.any? %>
      <dl class="mt-7 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        <% @showcase.facts.each do |label, value| %>
          <div class="fact">
            <dt class="label"><%= label %></dt>
            <dd class="fact-value" title="<%= value %>"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
    <% if @showcase.details.present? %>
      <div id="showcase-details" class="showcase-details mt-7 max-w-3xl border-t border-zinc-800 pt-5 text-zinc-300">
        <%= @showcase.rendered_details %>
      </div>
    <% end %>
  <% elsif @can_edit %>
    <div class="border border-dashed border-zinc-800 p-8">
      <span class="rice-label">the rice</span>
      <p class="mt-5 max-w-xl text-zinc-400">
        Your showcase is empty, and it is the main event on this page. Put a screenshot
        of your desktop here, say what is in it, and list what you run — it is the part
        people come to look at.
      </p>
      <%= link_to "Build your showcase", edit_showcase_path, class: "btn btn-primary mt-5" %>
    </div>
  <% end %>
</section>

<%# ── 6. THE PROFILE MARKUP ──────────────────────────────────────────────────────
    What the owner wrote, in the author's own stylesheet. No column around it and no
    card of ours: the page's own rules decide what it looks like, including whether
    the site's chrome is still here. %>
<article id="profile" class="profile-page mb-12">
  <% if @profile.document.blank? %>
    <div class="border border-dashed border-zinc-800 p-8">
      <p class="label">your page</p>
      <p class="mt-4 text-zinc-400">
        No markup yet — this is where anything you want goes, in HTML and CSS.
        <% if @can_edit %>
          <%= link_to "Write it", studio_path, class: "underline hover:text-zinc-200" %>.
        <% end %>
      </p>
    </div>
  <% else %>
    <%= @rendered.html %>
  <% end %>
</article>

<%# ── 7. WATCH ───────────────────────────────────────────────────────────────────
    The videos and streams. Nothing is hosted here: each is a link, embedded from
    the service that holds it. %>
<% if @stream_links.any? %>
  <section id="watch" class="mb-12">
    <h2 class="orangetext15 rule">
      <span class="label">watch</span>
      <span class="label text-zinc-600"><%= @stream_links.map(&:platform_label).join(" · ") %></span>
    </h2>
    <ul class="mt-5 grid gap-6 lg:grid-cols-2">
      <% @stream_links.each do |link| %>
        <% frame = link.embed %>
        <li class="stream">
          <div class="stream-frame border border-zinc-800 bg-zinc-950">
            <% if frame %>
              <iframe src="<%= frame[:src] %>" title="<%= frame[:title] %>"
                      style="aspect-ratio: <%= frame[:aspect] %>; width: 100%; display: block"
                      loading="lazy" allowfullscreen
                      allow="clipboard-write; encrypted-media; picture-in-picture"
                      referrerpolicy="strict-origin-when-cross-origin"
                      sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"></iframe>
            <% else %>
              <p class="p-4 text-sm text-zinc-500">This link cannot be embedded.</p>
            <% end %>
          </div>
          <div class="mt-3 flex flex-wrap items-baseline justify-between gap-2">
            <p class="nametext text-sm text-zinc-200"><%= link.display_title %></p>
            <a class="label hover:text-zinc-200" href="<%= link.url %>" rel="noopener noreferrer nofollow"
               target="_blank"><%= link.platform_label %> ↗</a>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# ── 8. DEMOS ───────────────────────────────────────────────────────────────────
    The demoscene. Its own category because a demo is not a video: the group, the
    party, the year, the platform and the placing are the entry. %>
<% if @demos.any? %>
  <section id="demos" class="mb-12">
    <h2 class="orangetext15 rule">
      <span class="label">demos</span>
      <span class="label text-zinc-600"><%= pluralize(@demos.size, "release") %></span>
    </h2>
    <ul class="mt-5 grid gap-6 lg:grid-cols-2">
      <% @demos.each do |demo| %>
        <% frame = demo.embed %>
        <li class="demo panel">
          <% if frame %>
            <iframe src="<%= frame[:src] %>" title="<%= demo.title %>"
                    class="block w-full border-b border-zinc-800"
                    style="aspect-ratio: <%= frame[:aspect] %>"
                    loading="lazy" allowfullscreen
                    allow="clipboard-write; encrypted-media; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"
                    sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"></iframe>
          <% end %>
          <div class="p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="demo-title nametext text-lg font-semibold text-zinc-100"><%= demo.title %></h3>
              <% if demo.placing_note %>
                <span class="demo-placing rice-label"><%= demo.placing_note %></span>
              <% end %>
            </div>
            <% if demo.group_name.present? || demo.release_note %>
              <p class="demo-credit mt-2 text-sm text-zinc-400">
                <%= demo.group_name %>
                <% if demo.group_name.present? && demo.release_note %>— <% end %>
                <%= demo.release_note %>
              </p>
            <% end %>
            <% facts = [ [ "category", demo.category ], [ "platform", demo.platform ] ].select { |_, v| v.present? } %>
            <% if facts.any? %>
              <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
                <% facts.each do |label, value| %>
                  <div class="fact">
                    <dt class="label"><%= label %></dt>
                    <dd class="fact-value"><%= value %></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
            <% if demo.watch_note.present? %>
              <p class="mt-4 text-sm text-zinc-500"><%= demo.watch_note %></p>
            <% end %>
            <% if demo.url.present? %>
              <p class="mt-4">
                <a class="btn" href="<%= demo.url %>" rel="noopener noreferrer nofollow" target="_blank">
                  <%= frame ? "Open on #{frame[:platform]}" : "Watch" %> ↗
                </a>
              </p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# ── 9. HARDWARE ───────────────────────────────────────────────────────────────
    Physical things: builds, racks, cooling, the closet. The photos are the evidence,
    so they lead; the facts are what is in it and how it is cooled. %>
<% if @builds.any? %>
  <section id="hardware" class="mb-12">
    <h2 class="orangetext15 rule">
      <span class="label">hardware</span>
      <span class="label text-zinc-600"><%= pluralize(@builds.size, "build") %></span>
    </h2>
    <ul class="mt-5 grid gap-8 lg:grid-cols-2">
      <% @builds.each do |build| %>
        <li class="build panel">
          <% cover = build.cover %>
          <% if cover %>
            <figure class="border-b border-zinc-800">
              <%= image_tag cover.image.variant(:display),
                    alt: cover.caption.presence || build.title,
                    class: "block aspect-[3/2] w-full object-cover" %>
              <% if cover.caption.present? %>
                <figcaption class="border-t border-zinc-800 px-3 py-2">
                  <span class="label"><%= cover.caption %></span>
                </figcaption>
              <% end %>
            </figure>
          <% end %>
          <div class="p-4">
            <h3 class="build-title nametext text-lg font-semibold text-zinc-100"><%= build.title %></h3>
            <% if build.summary.present? %>
              <p class="mt-2 text-sm text-zinc-400"><%= build.summary %></p>
            <% end %>
            <% if build.facts.any? %>
              <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
                <% build.facts.each do |label, value| %>
                  <div class="fact">
                    <dt class="label"><%= label %></dt>
                    <dd class="fact-value" title="<%= value %>"><%= value %></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
            <% if build.details.present? %>
              <div class="build-details mt-4 text-sm text-zinc-300"><%= build.rendered_details %></div>
            <% end %>
            <% others = build.photos.drop(cover ? 1 : 0).select { |photo| photo.image.attached? } %>
            <% if others.any? %>
              <ul class="mt-4 grid grid-cols-3 gap-px border border-zinc-800">
                <% others.each do |photo| %>
                  <li>
                    <%= image_tag photo.image.variant(:thumb), alt: photo.caption.presence || "",
                          class: "block aspect-[8/5] w-full object-cover" %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<p id="profile-stamp" class="label">
  markup by @<%= @user.username %>, last changed <%= time_ago_in_words(@profile.updated_at) %> ago
</p>
