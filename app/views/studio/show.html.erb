<% content_for :title, "Studio — RiceSpace" %>

<header class="mb-10 flex flex-wrap items-end justify-between gap-6">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Studio</h1>
    <p class="mt-3 max-w-2xl text-zinc-400">
      Signed in as <span class="text-zinc-200">@<%= current_user.username %></span>. Three
      things live here: the markup of your page, the facts around it, and the showcase
      that sits above it.
    </p>
  </div>
  <p class="flex flex-wrap gap-2">
    <%= link_to "Your page", profile_path(current_user), class: "btn" %>
    <%= link_to "Your showcase", edit_showcase_path, class: "btn btn-primary" %>
  </p>
</header>

<%# The showcase first, and out of order: it is the main event on the page, so the way to
    edit it is the first thing the studio offers rather than a section at the bottom. %>
<section class="mb-14 border border-amber-400/40 p-5">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <span class="rice-label">the rice</span>
      <p class="mt-4 max-w-2xl text-zinc-400">
        <% if current_user.showcase&.filled? %>
          Your showcase is on your page. Change the shot, the facts or the words.
        <% else %>
          Empty — and it is the main event on your page. A screenshot of your setup,
          what is in it, and what you run.
        <% end %>
      </p>
    </div>
    <%= link_to current_user.showcase&.filled? ? "Edit your showcase" : "Build your showcase",
          edit_showcase_path, class: "btn btn-primary" %>
  </div>
</section>

<section class="mb-14">
  <h2 class="rule">
    <span class="label">Your page</span>
    <span class="label text-zinc-600">markup, cleaned when it is shown</span>
  </h2>
  <p class="mt-5 max-w-2xl text-zinc-400">
    HTML and CSS. The tags of the era are here — <code class="text-zinc-300">&lt;marquee&gt;</code>,
    <code class="text-zinc-300">&lt;font&gt;</code>, <code class="text-zinc-300">&lt;center&gt;</code>,
    tables — and a <code class="text-zinc-300">&lt;style&gt;</code> block lays out the whole page.
    Nothing here is a template: what you write is the page.
  </p>

  <% if @conflicted %>
    <p class="mt-5 border border-amber-700 bg-amber-950 p-3 text-sm text-amber-200">
      Somebody — most likely your own agent — wrote this page while you were editing it, so
      your save was refused. What you typed is still in the editor below; saving again
      replaces their version with yours.
    </p>
  <% end %>

  <% if @profile.errors.any? %>
    <ul class="mt-5 space-y-px border border-red-900 bg-red-950 p-3 text-sm text-red-200">
      <% @profile.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @profile, url: studio_path, method: :patch, class: "mt-5" do |form| %>
    <%# The revision this editor was showing. It is how a save can tell that the page
        moved underneath it. %>
    <%= form.hidden_field :version, value: @profile.version %>
    <%= form.text_area :document, rows: 24, spellcheck: false,
          class: "field leading-relaxed",
          placeholder: "<style>\n  body { background: #111; color: #0ff }\n</style>\n<marquee>welcome to my page</marquee>" %>
    <div class="mt-4 flex flex-wrap items-center gap-4">
      <%= form.submit "Save page", class: "btn btn-primary" %>
      <span class="label">saved as you write it, cleaned when it is shown</span>
    </div>
  <% end %>
</section>

<section class="mb-14">
  <h2 class="rule">
    <span class="label">The page's bits</span>
    <span class="label text-zinc-600">what a pasted layout can reach</span>
  </h2>
  <p class="mt-5 max-w-2xl text-zinc-400">
    These are the sections a layout targets by name: a picture, a greeting, a mood, blocks
    of text, a song, and your friends list. A stylesheet pasted from 2006 lands on them —
    the friends list is <code class="text-zinc-300">.friendSpace</code>, the picture is
    <code class="text-zinc-300">.profile-pic</code>, a blurb is <code class="text-zinc-300">.blurb</code>.
  </p>

  <div class="mt-8 grid gap-10 lg:grid-cols-2">
    <div>
      <h3 class="label">Picture, name, greeting</h3>

      <%= form_with url: profile_picture_path, method: :patch, multipart: true, class: "mt-5" do |form| %>
        <div class="flex items-center gap-4">
          <% if @picture&.image&.attached? %>
            <%= image_tag @picture.image.variant(:display), alt: "your picture",
                  class: "h-24 w-24 border border-zinc-700 object-cover" %>
          <% else %>
            <span class="flex h-24 w-24 items-center justify-center border border-dashed border-zinc-800">
              <span class="label">no pic</span>
            </span>
          <% end %>
          <div class="min-w-0">
            <%= form.file_field :image, accept: "image/*",
                  class: "text-xs text-zinc-400 file:mr-3 file:border file:border-zinc-700 file:bg-zinc-900 file:px-2 file:py-1 file:text-zinc-200" %>
            <p class="label mt-2">an image, up to <%= ProfilePicture::MAX_BYTES / 1.megabyte %> MB</p>
          </div>
        </div>
        <%= form.submit "Upload picture", class: "btn mt-4" %>
      <% end %>

      <% if @picture&.image&.attached? %>
        <%= button_to "Remove picture", profile_picture_path, method: :delete, class: "label mt-3 hover:text-red-300" %>
      <% end %>

      <%= form_with model: current_user, url: account_path, method: :patch, class: "mt-8 grid gap-4" do |form| %>
        <label class="block">
          <span class="label">display name</span>
          <%= form.text_field :name, maxlength: 60, class: "field mt-2" %>
        </label>
        <label class="block">
          <span class="label">greeting</span>
          <%= form.text_field :greeting, maxlength: 140, placeholder: "welcome to my page", class: "field mt-2" %>
        </label>
        <label class="block">
          <span class="label">mood</span>
          <%= form.text_field :mood, maxlength: 40, placeholder: "listening to the modem handshake", class: "field mt-2" %>
        </label>
        <label class="block">
          <span class="label">headline</span>
          <%= form.text_field :headline, maxlength: 140, class: "field mt-2" %>
        </label>
        <div><%= form.submit "Save details", class: "btn" %></div>
      <% end %>

      <h3 class="label mt-10">Profile song</h3>
      <p class="mt-4 max-w-lg text-sm text-zinc-500">
        One track, played on your page as <code class="text-zinc-300">.audio.player</code>. It is
        not downloaded until a visitor presses play.
      </p>

      <%= form_with model: current_user.profile, url: update_song_studio_path, method: :patch, class: "mt-5 grid gap-4" do |form| %>
        <%= form.hidden_field :version, value: current_user.profile.version %>
        <%# The song is saved through the page it belongs to, so it takes the same
            revision check as the markup. %>
        <label class="block">
          <span class="label">title</span>
          <%= form.text_field :song_title, maxlength: 120, placeholder: "song title", class: "field mt-2" %>
        </label>
        <label class="block">
          <span class="label">url</span>
          <%= form.url_field :song_url, placeholder: "https://example.com/song.mp3", class: "field mt-2" %>
        </label>
        <div><%= form.submit "Save song", class: "btn" %></div>
      <% end %>
    </div>

    <div>
      <h3 class="label">Blurbs</h3>
      <p class="mt-4 max-w-lg text-sm text-zinc-500">
        A titled block: Interests, Music, Heroes, whatever you want. The body takes the same
        markup as your page.
      </p>

      <% if @blurbs.any? %>
        <ol class="mt-5 space-y-px border border-zinc-800">
          <% @blurbs.each do |blurb| %>
            <li class="bg-zinc-950 p-3">
              <%= form_with model: blurb, class: "grid gap-3" do |form| %>
                <div class="flex items-center gap-2">
                  <%= form.text_field :title, maxlength: Blurb::MAX_TITLE_LENGTH, class: "field w-48" %>
                  <span class="flex items-center gap-1">
                    <%= button_tag "↑", name: "direction", value: "up", formaction: move_blurb_path(blurb),
                          formmethod: :patch, class: "btn px-2 py-1" %>
                    <%= button_tag "↓", name: "direction", value: "down", formaction: move_blurb_path(blurb),
                          formmethod: :patch, class: "btn px-2 py-1" %>
                  </span>
                </div>
                <%= form.text_area :body, rows: 3, class: "field" %>
                <div><%= form.submit "Save", class: "btn" %></div>
              <% end %>
              <%= button_to "Remove", blurb_path(blurb), method: :delete, class: "label mt-3 hover:text-red-300" %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-5 text-sm text-zinc-500">No blurbs yet.</p>
      <% end %>

      <%= form_with scope: :blurb, url: blurbs_path, class: "mt-5 grid gap-3" do |form| %>
        <%= form.text_field :title, placeholder: "Interests", required: true,
              maxlength: Blurb::MAX_TITLE_LENGTH, class: "field" %>
        <%= form.text_area :body, rows: 3, placeholder: "what you are into", class: "field" %>
        <div><%= form.submit "Add blurb", class: "btn" %></div>
      <% end %>
    </div>
  </div>

  <div class="mt-12">
    <h3 class="label">Friends</h3>
    <p class="mt-4 max-w-2xl text-sm text-zinc-500">
      Your list appears on your page as <code class="text-zinc-300">.friendSpace</code>. You can
      also add somebody from your own page.
    </p>

    <% if @friendships.any? %>
      <ul class="mt-5 grid gap-px border border-zinc-800 sm:grid-cols-2">
        <% @friendships.each_with_index do |friendship, index| %>
          <li class="flex items-center gap-3 bg-zinc-950 px-3 py-2">
            <span class="label w-6"><%= index < ProfilesController::TOP_EIGHT ? "★" : format("%02d", index + 1) %></span>
            <%= link_to friendship.friend.display_name, profile_path(friendship.friend),
                  class: "truncate text-sm text-zinc-200 hover:text-amber-300" %>
            <span class="ml-auto flex items-center gap-1">
              <%= button_tag "↑", name: "direction", value: "up", formaction: move_friendship_path(friendship),
                    formmethod: :patch, class: "btn px-2 py-1" %>
              <%= button_tag "↓", name: "direction", value: "down", formaction: move_friendship_path(friendship),
                    formmethod: :patch, class: "btn px-2 py-1" %>
              <%= button_to "×", friendship_path(friendship), method: :delete,
                    class: "btn px-2 py-1 hover:text-red-300" %>
            </span>
          </li>
        <% end %>
      </ul>
      <p class="label mt-3">
        the first <%= ProfilesController::TOP_EIGHT %> show first on your page — starred above
      </p>
    <% else %>
      <p class="mt-5 text-sm text-zinc-500">No friends listed yet.</p>
    <% end %>

    <%= form_with url: friendships_path, class: "mt-5 flex flex-wrap items-center gap-2" do |form| %>
      <%= form.text_field :username, placeholder: "their username", required: true, class: "field w-48" %>
      <%= form.submit "Add friend", class: "btn" %>
    <% end %>
  </div>
</section>

<section>
  <h2 class="rule">
    <span class="label">Write it with an agent</span>
    <span class="label text-zinc-600">optional</span>
  </h2>
  <p class="mt-5 max-w-2xl text-zinc-400">
    Hand your coding agent a token and it can read and rewrite the same page over the HTTP
    API — useful for a page you would rather generate than type. Revoke the token when it is
    done. <%= link_to "What an agent can write", agents_path, class: "underline hover:text-zinc-200" %>.
  </p>

  <% if @issued_token.present? %>
    <section class="mt-6 border border-amber-400/40 p-5">
      <span class="rice-label">shown once</span>
      <pre class="mt-4 overflow-x-auto border border-zinc-800 bg-zinc-950 p-3 text-xs text-amber-100"><%= @issued_token %></pre>
      <p class="label mt-3">
        this is the only time it is shown — if you lose it, revoke it and issue another
      </p>
    </section>
  <% end %>

  <%= form_with scope: :agent_token, url: agent_tokens_path, class: "mt-5 flex flex-wrap items-center gap-2" do |form| %>
    <%= form.text_field :name, placeholder: "Claude Code", required: true, class: "field w-56" %>
    <%= form.submit "Issue token", class: "btn" %>
  <% end %>

  <% if @tokens.any? %>
    <table class="mt-6 w-full border-collapse text-left text-sm">
      <thead class="border-b border-zinc-800">
        <tr>
          <th class="label py-2 font-medium">Name</th>
          <th class="label py-2 font-medium">Issued</th>
          <th class="label py-2 font-medium">Last used</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @tokens.each do |token| %>
          <tr class="border-b border-zinc-900">
            <td class="py-3 text-zinc-200"><%= token.name %></td>
            <td class="py-3 text-zinc-500"><%= token.created_at.to_date.to_fs(:long) %></td>
            <td class="py-3 text-zinc-500">
              <%= token.last_used_at ? "#{time_ago_in_words(token.last_used_at)} ago" : "never" %>
            </td>
            <td class="py-3 text-right">
              <%= button_to "Revoke", agent_token_path(token), method: :delete, class: "label hover:text-red-300" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="mt-5 text-sm text-zinc-500">No tokens yet.</p>
  <% end %>
</section>
