<% content_for :title, "Studio — RiceSpace" %>

<h1 class="text-2xl font-bold tracking-tight">Studio</h1>
<p class="mt-1 text-sm text-zinc-500">
  You are signed in as <strong class="text-zinc-300">@<%= current_user.username %></strong>.
  <%= link_to "See your page", profile_path(current_user), class: "text-fuchsia-400 hover:text-fuchsia-300" %>
</p>

<section class="mt-8">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-500">Your page</h2>
  <p class="mt-2 max-w-2xl text-sm text-zinc-400">
    HTML and CSS. Use the tags of the era — <code class="text-zinc-300">&lt;marquee&gt;</code>,
    <code class="text-zinc-300">&lt;font&gt;</code>, <code class="text-zinc-300">&lt;center&gt;</code>,
    tables — and a <code class="text-zinc-300">&lt;style&gt;</code> block to lay the whole page out.
    Nothing here is a template: what you write is the page.
  </p>

  <% if @conflicted %>
    <p class="mt-3 rounded border border-amber-700 bg-amber-950/50 p-3 text-sm text-amber-200">
      Somebody — most likely your own agent — wrote this page while you were editing it, so your save
      was refused. What you typed is still in the editor below; saving again replaces their version
      with yours.
    </p>
  <% end %>

  <% if @profile.errors.any? %>
    <ul class="mt-3 space-y-1 rounded border border-red-800 bg-red-950/60 p-3 text-sm text-red-200">
      <% @profile.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @profile, url: studio_path, method: :patch, class: "mt-3" do |form| %>
    <%# The revision this editor was showing. It is how a save can tell that the
        page moved underneath it. %>
    <%= form.hidden_field :version, value: @profile.version %>
    <%= form.text_area :document, rows: 24, spellcheck: false,
          class: "w-full rounded-lg border border-zinc-700 bg-zinc-950 p-4 font-mono text-xs leading-relaxed text-zinc-200 focus:border-fuchsia-500 focus:outline-none",
          placeholder: "<style>\n  body { background: #111; color: #0ff }\n</style>\n<marquee>welcome to my page</marquee>" %>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <%= form.submit "Save page",
            class: "rounded bg-fuchsia-500 px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-fuchsia-400" %>
      <span class="text-xs text-zinc-500">
        Your page is saved as you write it and cleaned when it is shown, so a tightened rule applies to
        every page at once.
      </span>
    </div>
  <% end %>
</section>

<section class="mt-10 border-t border-zinc-800 pt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-500">Your page's bits</h2>
  <p class="mt-2 max-w-2xl text-sm text-zinc-400">
    These are the sections a layout can target: a picture, a greeting, a mood, blocks of text, and your
    friends list. A stylesheet pasted from 2006 lands on them by name — the friends list is
    <code class="text-zinc-300">.friendSpace</code>, the picture is
    <code class="text-zinc-300">.profile-pic</code>, a blurb is <code class="text-zinc-300">.blurb</code>.
  </p>

  <div class="mt-6 grid gap-8 lg:grid-cols-2">
    <div>
      <h3 class="text-sm font-semibold text-zinc-300">Picture, greeting, mood</h3>

      <%= form_with url: profile_picture_path, method: :patch, multipart: true, class: "mt-3 space-y-3" do |form| %>
        <div class="flex items-center gap-3">
          <% if @picture&.image&.attached? %>
            <%= image_tag @picture.image.variant(:display), alt: "your picture",
                  class: "h-20 w-20 rounded border border-zinc-700 object-cover" %>
          <% else %>
            <span class="flex h-20 w-20 items-center justify-center rounded border border-dashed border-zinc-700 text-xs text-zinc-600">
              no pic
            </span>
          <% end %>
          <div>
            <%= form.file_field :image, accept: "image/*",
                  class: "text-xs text-zinc-400 file:mr-2 file:rounded file:border file:border-zinc-700 file:bg-zinc-900 file:px-2 file:py-1 file:text-zinc-200" %>
            <p class="mt-1 text-xs text-zinc-600">An image, up to <%= ProfilePicture::MAX_BYTES / 1.megabyte %> MB.</p>
          </div>
        </div>
        <%= form.submit "Upload picture",
              class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
      <% end %>

      <% if @picture&.image&.attached? %>
        <%= button_to "Remove picture", profile_picture_path, method: :delete,
              class: "mt-2 text-xs text-red-400 hover:text-red-300" %>
      <% end %>

      <%= form_with model: current_user, url: account_path, method: :patch, class: "mt-5 space-y-3" do |form| %>
        <div>
          <%= form.label :name, "Display name", class: "block text-xs text-zinc-500" %>
          <%= form.text_field :name, maxlength: 60,
                class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
        </div>
        <div>
          <%= form.label :greeting, "Greeting", class: "block text-xs text-zinc-500" %>
          <%= form.text_field :greeting, maxlength: 140, placeholder: "welcome to my page",
                class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
        </div>
        <div>
          <%= form.label :mood, "Mood", class: "block text-xs text-zinc-500" %>
          <%= form.text_field :mood, maxlength: 40, placeholder: "listening to the modem handshake",
                class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
        </div>
        <div>
          <%= form.label :headline, "Headline", class: "block text-xs text-zinc-500" %>
          <%= form.text_field :headline, maxlength: 140,
                class: "mt-1 w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
        </div>
        <%= form.submit "Save details",
              class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
      <% end %>

      <h3 class="mt-6 text-sm font-semibold text-zinc-300">Profile song</h3>
      <p class="mt-1 text-xs text-zinc-600">
        One track, played on your page as <code class="text-zinc-300">.audio.player</code>. It is not
        downloaded until a visitor presses play.
      </p>

      <%= form_with model: current_user.profile, url: update_song_studio_path, method: :patch, class: "mt-3 space-y-3" do |form| %>
        <%= form.hidden_field :version, value: current_user.profile.version %>
        <%# The song is saved through the page it belongs to, so it takes the same
            revision check as the markup. %>
        <%= form.text_field :song_title, maxlength: 120, placeholder: "song title",
              class: "w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
        <%= form.url_field :song_url, placeholder: "https://example.com/song.mp3",
              class: "w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
        <%= form.submit "Save song",
              class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
      <% end %>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-zinc-300">Blurbs</h3>
      <p class="mt-1 text-xs text-zinc-600">
        A titled block: Interests, Music, Heroes, whatever you want. The body takes the same HTML as
        your page.
      </p>

      <% if @blurbs.any? %>
        <ul class="mt-3 space-y-3">
          <% @blurbs.each do |blurb| %>
            <li class="rounded border border-zinc-800 bg-zinc-900/40 p-3">
              <%= form_with model: blurb, class: "space-y-2" do |form| %>
                <div class="flex items-center gap-2">
                  <%= form.text_field :title, maxlength: Blurb::MAX_TITLE_LENGTH,
                        class: "w-40 rounded border border-zinc-700 bg-zinc-950 px-2 py-1 text-sm text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
                  <span class="flex gap-1 text-xs">
                    <%= button_tag "↑", name: "direction", value: "up", formaction: move_blurb_path(blurb),
                          formmethod: :patch, class: "rounded border border-zinc-700 px-2 py-1 text-zinc-300 hover:border-zinc-500" %>
                    <%= button_tag "↓", name: "direction", value: "down", formaction: move_blurb_path(blurb),
                          formmethod: :patch, class: "rounded border border-zinc-700 px-2 py-1 text-zinc-300 hover:border-zinc-500" %>
                  </span>
                </div>
                <%= form.text_area :body, rows: 3,
                      class: "w-full rounded border border-zinc-700 bg-zinc-950 px-2 py-1 font-mono text-xs text-zinc-200 focus:border-fuchsia-500 focus:outline-none" %>
                <%= form.submit "Save",
                      class: "rounded border border-zinc-700 px-2 py-1 text-xs text-zinc-200 hover:border-zinc-500" %>
              <% end %>
              <%= button_to "Remove", blurb_path(blurb), method: :delete,
                    class: "mt-2 text-xs text-red-400 hover:text-red-300" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-zinc-500">No blurbs yet.</p>
      <% end %>

      <%= form_with scope: :blurb, url: blurbs_path, class: "mt-4 space-y-2" do |form| %>
        <%= form.text_field :title, placeholder: "Interests", required: true, maxlength: Blurb::MAX_TITLE_LENGTH,
              class: "w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
        <%= form.text_area :body, rows: 3, placeholder: "what you are into",
              class: "w-full rounded border border-zinc-700 bg-zinc-950 px-3 py-2 font-mono text-xs text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
        <%= form.submit "Add blurb",
              class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <h3 class="text-sm font-semibold text-zinc-300">Friends</h3>
    <p class="mt-1 text-xs text-zinc-600">
      Your list appears on your page as <code class="text-zinc-300">.friendSpace</code>. You can also
      add somebody from your own page.
    </p>

    <% if @friendships.any? %>
      <ul class="mt-3 flex flex-wrap gap-2">
        <% @friendships.each_with_index do |friendship, index| %>
          <li class="flex items-center gap-2 rounded border <%= index < ProfilesController::TOP_EIGHT ? "border-fuchsia-800" : "border-zinc-800" %> bg-zinc-900/40 px-3 py-1.5 text-sm">
            <%= link_to friendship.friend.display_name, profile_path(friendship.friend), class: "text-zinc-200 hover:text-zinc-100" %>
            <span class="flex gap-1 text-xs">
              <%= button_tag "↑", name: "direction", value: "up", formaction: move_friendship_path(friendship),
                    formmethod: :patch, class: "rounded border border-zinc-700 px-1.5 text-zinc-300 hover:border-zinc-500" %>
              <%= button_tag "↓", name: "direction", value: "down", formaction: move_friendship_path(friendship),
                    formmethod: :patch, class: "rounded border border-zinc-700 px-1.5 text-zinc-300 hover:border-zinc-500" %>
            </span>
            <%= button_to "Remove", friendship_path(friendship), method: :delete,
                  class: "text-xs text-red-400 hover:text-red-300" %>
          </li>
        <% end %>
      </ul>
      <p class="mt-2 text-xs text-zinc-600">
        The first <%= ProfilesController::TOP_EIGHT %> are the ones your page shows first, at the top of
        the list. Drag the arrows to change which.
      </p>
    <% else %>
      <p class="mt-3 text-sm text-zinc-500">No friends listed yet.</p>
    <% end %>

    <%= form_with url: friendships_path, class: "mt-3 flex flex-wrap items-center gap-2" do |form| %>
      <%= form.text_field :username, placeholder: "their username", required: true,
            class: "rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
      <%= form.submit "Add friend",
            class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
    <% end %>
  </div>
</section>

<section class="mt-10 border-t border-zinc-800 pt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-500">Write it with an agent</h2>
  <p class="mt-2 max-w-2xl text-sm text-zinc-400">
    Optional: hand your coding agent a token and it can read and rewrite the same page over the HTTP
    API — useful for a page you would rather generate than type. Revoke the token when it is done.
    <%= link_to "What an agent can write", agents_path, class: "text-fuchsia-400 hover:text-fuchsia-300" %>.
  </p>

  <% if @issued_token.present? %>
    <section class="mt-4 rounded-lg border border-fuchsia-700 bg-fuchsia-950/40 p-5">
      <h3 class="font-semibold text-fuchsia-200">Your new agent token</h3>
      <p class="mt-1 text-sm text-fuchsia-200/80">
        This is the only time it is shown. If you lose it, revoke it and issue another.
      </p>
      <pre class="mt-3 overflow-x-auto rounded border border-fuchsia-800 bg-zinc-950 p-3 font-mono text-xs text-fuchsia-100"><%= @issued_token %></pre>
      <p class="mt-3 text-xs text-fuchsia-200/70">
        Tell your agent to read <%= link_to agents_markdown_path, agents_markdown_path, class: "underline" %> first.
      </p>
    </section>
  <% end %>

  <%= form_with scope: :agent_token, url: agent_tokens_path, class: "mt-4 flex flex-wrap items-center gap-2" do |form| %>
    <%= form.text_field :name, placeholder: "Claude Code", required: true,
          class: "rounded border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-fuchsia-500 focus:outline-none" %>
    <%= form.submit "Issue token",
          class: "rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-zinc-500" %>
  <% end %>

  <% if @tokens.any? %>
    <table class="mt-5 w-full text-left text-sm">
      <thead class="text-xs uppercase tracking-wider text-zinc-500">
        <tr>
          <th class="py-2 font-medium">Name</th>
          <th class="py-2 font-medium">Issued</th>
          <th class="py-2 font-medium">Last used</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <% @tokens.each do |token| %>
          <tr>
            <td class="py-2 text-zinc-200"><%= token.name %></td>
            <td class="py-2 text-zinc-500"><%= token.created_at.to_date.to_fs(:long) %></td>
            <td class="py-2 text-zinc-500">
              <%= token.last_used_at ? "#{time_ago_in_words(token.last_used_at)} ago" : "never" %>
            </td>
            <td class="py-2 text-right">
              <%= button_to "Revoke", agent_token_path(token), method: :delete,
                    class: "text-xs text-red-400 hover:text-red-300" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">No tokens yet.</p>
  <% end %>
</section>
