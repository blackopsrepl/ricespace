<% content_for :title, "RiceSpace — pages you write yourself" %>

<section class="mb-10">
  <h1 class="text-3xl font-bold tracking-tight">Pages you write yourself.</h1>
  <p class="mt-3 max-w-2xl text-zinc-400">
    Every account gets a page and the HTML and CSS to fill it. Write it in the studio, wear a layout
    somebody else wrote, or hand a coding agent a token and let it write the page for you. No app
    store, no algorithm — just the pages.
  </p>
  <div class="mt-5 flex flex-wrap gap-3 text-sm">
    <%= link_to "Create a page", new_registration_path,
          class: "rounded bg-fuchsia-500 px-4 py-2 font-medium text-zinc-950 hover:bg-fuchsia-400" %>
    <%= link_to "Browse layouts", layouts_path,
          class: "rounded border border-zinc-700 px-4 py-2 text-zinc-300 hover:border-zinc-500 hover:text-zinc-100" %>
    <%= link_to "What an agent can write", agents_path,
          class: "rounded border border-zinc-700 px-4 py-2 text-zinc-300 hover:border-zinc-500 hover:text-zinc-100" %>
  </div>
  <p class="mt-4 text-xs text-zinc-600">
    <%= pluralize(@profile_count, "page") %> so far.
  </p>
</section>

<section>
  <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-zinc-500">Recently changed</h2>

  <% if @profiles.any? %>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @profiles.each do |profile| %>
        <li class="profile-card rounded-lg border border-zinc-800 bg-zinc-900/40 p-4">
          <%# The page's own colours, read out of its stylesheet — the closest a
              directory can get to showing the page without showing it. %>
          <% thumbnail = PageThumbnail.new(profile.rendered.css) %>
          <div class="mb-3 h-16 rounded border border-zinc-800 p-2"
               style="<%= background_style(thumbnail.background) %>">
            <span class="text-sm font-semibold" style="<%= colour_style(thumbnail.foreground, fallback: "#a1a1aa") %>">
              <%= profile.user.display_name %>
            </span>
            <span class="block text-[10px]" style="<%= colour_style(thumbnail.foreground, fallback: "#a1a1aa") %>">
              @<%= profile.user.username %>
            </span>
          </div>

          <div class="flex items-center gap-2">
            <% if profile.user.profile_picture&.image&.attached? %>
              <%= image_tag profile.user.profile_picture.image.variant(:thumb), alt: "",
                    class: "h-8 w-8 rounded border border-zinc-700 object-cover" %>
            <% end %>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold"><%= profile.user.display_name %></p>
              <% if profile.user.greeting.present? %>
                <p class="truncate text-xs text-zinc-500"><%= profile.user.greeting %></p>
              <% end %>
            </div>
          </div>

          <% if profile.song? %>
            <p class="mt-2 truncate text-xs text-zinc-500">
              ♫ <%= profile.song_title.presence || "a song" %>
            </p>
          <% end %>

          <div class="mt-3 flex flex-wrap items-center gap-3 text-xs">
            <%= link_to "Visit page", profile_path(profile.user), class: "text-fuchsia-400 hover:text-fuchsia-300" %>
            <% if profile.document.include?("<style") %>
              <%= button_to "Take its layout", copy_layout_profile_path(profile.user), method: :post,
                    class: "text-zinc-400 hover:text-zinc-200" if signed_in? %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-lg border border-dashed border-zinc-800 p-6 text-sm text-zinc-500">
      No pages have been written yet. Yours can be the first.
    </p>
  <% end %>
</section>

<section class="mt-12">
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-500">Layouts to wear</h2>
    <%= link_to "All layouts", layouts_path, class: "text-xs text-fuchsia-400 hover:text-fuchsia-300" %>
  </div>

  <ul class="grid gap-4 sm:grid-cols-3">
    <% @layouts.each do |layout| %>
      <li class="rounded-lg border border-zinc-800 bg-zinc-900/40 p-4">
        <p class="font-semibold text-zinc-100"><%= layout.name %></p>
        <p class="mt-1 text-xs text-zinc-500"><%= layout.description %></p>
        <p class="mt-3 text-xs">
          <%= link_to "Preview", layout_path(layout), class: "text-fuchsia-400 hover:text-fuchsia-300" %>
        </p>
      </li>
    <% end %>
  </ul>
</section>
